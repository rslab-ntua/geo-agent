// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "Copernicus Agents v1",
	"build": {
		// Sets the run context to one level up instead of the .devcontainer folder.
		"context": "..",
		// Update the 'dockerfile' property if you aren't using the standard 'Dockerfile' filename.
		"dockerfile": "../Dockerfile",
		"args": {
			"USER_ID": "1002",
			"GROUP_ID": "1001"
		}
	},
	"runArgs": [
		"--gpus",
		"all",
		"--network",
		"rag_network"
	],
	// Set environment variables inside the container.
	"containerEnv": {
		"KERAS_BACKEND": "torch"
	},
	// Mount additional volumes inside the container.
	"mounts": [
		"source=/mnt/nvme2/bicubes/journal_bicubes/geo-agent,target=/workspace,type=bind"
	],
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-toolsai.tensorboard"
			]
		}
	},
	// Connect as the non-root user defined in the Dockerfile.
	"remoteUser": "my_user"
}